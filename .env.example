# LLM provider (default gemini). Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Only needed if you switch LLM_PROVIDER to anthropic
ANTHROPIC_API_KEY=

# Supabase: project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Job source APIs (free tiers)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_key

# Email: Resend for digests
RESEND_API_KEY=your_resend_key
FROM_EMAIL=you@yourdomain.com
TO_EMAIL=you@gmail.com

# Gmail IMAP for reading APPROVE/SKIP replies (use an App Password)
IMAP_USER=you@gmail.com
IMAP_PASSWORD=your_gmail_app_password

# Optional model overrides
# MATCH_MODEL=gemini-2.5-flash
# WRITER_MODEL=gemini-2.5-pro

# Set to 1 to fill forms without submitting
DRY_RUN=1